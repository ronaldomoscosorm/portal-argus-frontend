# ============================================================
# Portal Argus — Frontend (R&M Tecnologia)
# Copie este arquivo para .env e ajuste conforme o ambiente.
# ============================================================

# URL base do PortalArgus.Api (BFF). A SPA fala APENAS com o BFF, que repassa
# login/MFA/refresh/me/admin para a ArthosMFA e devolve o corpo já "desembrulhado".
# Dev local: https://localhost:5201 | Produção: URL pública do PortalArgus.Api.
VITE_AUTH_API_URL="https://localhost:5201"

# Identidade visual — aparece no header e no <title>.
VITE_CLIENT_NAME="Portal Argus"

# Cor primária da marca em hex (sem #). Referência; os tokens efetivos vivem
# em src/index.css (variáveis --primary / --brand em HSL).
VITE_BRAND_PRIMARY_HEX="0F2840"
